<Window x:Class="SGrab.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#55000000"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross">
    <Canvas x:Name="RootCanvas">
        <!-- Selection rectangle (hidden until the user starts dragging). -->
        <Rectangle x:Name="SelectionRect"
                   Visibility="Collapsed"
                   Stroke="#FF3DA5FF" StrokeThickness="2"
                   Fill="#220078D7"/>
        <Border x:Name="SizeBadge"
                Visibility="Collapsed"
                Background="#CC000000" CornerRadius="3" Padding="6,3">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12"/>
        </Border>
        <TextBlock x:Name="Hint"
                   Text="Drag to select a region · Esc to cancel"
                   Foreground="#DDFFFFFF" FontSize="14"
                   Canvas.Left="20" Canvas.Top="20"/>
    </Canvas>
</Window>
