<Window x:Class="SGrab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SGrab" Height="520" Width="820"
        MinHeight="380" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="SGrab"
                       FontSize="40" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="Press the button or Ctrl+Shift+S to capture a region"
                       FontSize="14" Foreground="#AAAAAA"
                       HorizontalAlignment="Center" Margin="0,0,0,28"/>
            <Button Content="New Capture"
                    Command="{Binding NewCaptureCommand}"
                    Width="240" Height="68" FontSize="22" Cursor="Hand"/>
        </StackPanel>

        <!-- Filmstrip placeholder; populated in TICKET-0013. -->
        <Border Grid.Row="1" Height="132"
                Background="#252526" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <TextBlock Text="Recent screenshots will appear here (TICKET-0013)"
                       Foreground="#777777"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
