<Window x:Class="SGrab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SGrab.Common"
        Title="SGrab" Height="560" Width="860"
        MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Window.Resources>
        <conv:PathToImageConverter x:Key="PathToImage"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="SGrab"
                       FontSize="40" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="Press the button or Ctrl+Shift+S to capture a region"
                       FontSize="14" Foreground="#AAAAAA"
                       HorizontalAlignment="Center" Margin="0,0,0,28"/>
            <Button Content="New Capture"
                    Command="{Binding NewCaptureCommand}"
                    Width="240" Height="68" FontSize="22" Cursor="Hand"/>
        </StackPanel>

        <!-- Filmstrip: scrollable history of past captures. -->
        <Border Grid.Row="1" Height="140"
                Background="#252526" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="No screenshots yet — press New Capture to start"
                           Foreground="#777777" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasScreenshots, Converter={StaticResource InverseBoolToVis}}"/>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Padding="8,10">
                    <ItemsControl ItemsSource="{Binding Screenshots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6,0" Padding="3" Background="#1E1E1E"
                                        BorderBrush="#444444" BorderThickness="1" Cursor="Hand"
                                        ToolTip="Click to open in the editor"
                                        MouseLeftButtonUp="OnThumbnailClick">
                                    <Grid>
                                        <Image Source="{Binding ThumbPath, Converter={StaticResource PathToImage}}"
                                               Height="96" Stretch="Uniform"/>
                                        <Button Content="✕" Click="OnThumbnailDelete"
                                                Width="18" Height="18" Padding="0" FontSize="10"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                ToolTip="Delete"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
